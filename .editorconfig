# EditorConfig — Nucleus root
# Docs: https://editorconfig.org/
#
# Pins indent + line-ending + charset rules across the polyglot project
# (Python core, TS/React Workbench, YAML governance, Markdown docs).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,scss,html}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
