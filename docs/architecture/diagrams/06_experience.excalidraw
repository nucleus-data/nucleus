      "type": "text",
      "x": 718,
      "y": 232,
      "width": 441,
      "height": 134,
      "text": "ctx SDK (Python)   developer surface\n\n@nucleus.asset(key, deps, partitions, schedule)\n@nucleus.check(asset, severity)\nnucleus.materialize(asset_key) -> MaterializationResult\nctx.read(asset_key) -> LazyFrame\nctx.sql(\"... {{ ref('a') }} ...\")\nctx.copy_from(source, target=...) - postgres / s3 / parquet ...",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "ctx SDK (Python)   developer surface\n\n@nucleus.asset(key, deps, partitions, schedule)\n@nucleus.check(asset, severity)\nnucleus.materialize(asset_key) -> MaterializationResult\nctx.read(asset_key) -> LazyFrame\nctx.sql(\"... {{ ref('a') }} ...\")\nctx.copy_from(source, target=...) - postgres / s3 / parquet ...",
      "lineHeight": 1.25,
      "autoResize": true
    },
