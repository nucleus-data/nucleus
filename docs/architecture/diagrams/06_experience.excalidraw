      "type": "text",
      "x": 78,
      "y": 832,
      "width": 350,
      "height": 167,
      "text": "nucleus CLI   operator surface\n\nnucleus init my-warehouse\nnucleus up   /   nucleus down\nnucleus run <asset_key>\nnucleus ingest postgres://... --table T --as raw.T\nnucleus query \"SELECT ... FROM raw.T LIMIT 10\"\nnucleus list   /   nucleus runs (ledger)\nnucleus chat \"why did fct_orders fail?\"\nnucleus workbench   /   nucleus snapshot",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "nucleus CLI   operator surface\n\nnucleus init my-warehouse\nnucleus up   /   nucleus down\nnucleus run <asset_key>\nnucleus ingest postgres://... --table T --as raw.T\nnucleus query \"SELECT ... FROM raw.T LIMIT 10\"\nnucleus list   /   nucleus runs (ledger)\nnucleus chat \"why did fct_orders fail?\"\nnucleus workbench   /   nucleus snapshot",
