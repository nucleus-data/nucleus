# ============================================================================
# Nucleus — Example environment variables
# ============================================================================
# Copy this file to .env (gitignored) and fill in real values for local dev.
# Per docs/conventions/engineering.md §8.3, precedence is:
#   CLI flag  >  .env.local  >  .env  >  defaults
#
# Never commit .env or .env.local to git (the .gitignore already covers them).
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
NUCLEUS_LOG_LEVEL=INFO

# Tier the LOC-budget script enforces against: 01, 05, or 10.
# (Auto-detected from progress later; explicit override for testing.)
NUCLEUS_TIER=01

# ----------------------------------------------------------------------------
# Integration test services
# ----------------------------------------------------------------------------
# Set these when running `make test-integration`. CI sets them automatically.

# Test Postgres (e.g. when running docker-compose or testcontainers locally).
NUCLEUS_TEST_PG_DSN=postgres://nucleus:nucleus_test@localhost:5432/nucleus_test

# Test MinIO (S3-compatible).
NUCLEUS_TEST_S3_ENDPOINT=http://localhost:9000
NUCLEUS_TEST_S3_ACCESS_KEY=nucleus
NUCLEUS_TEST_S3_SECRET_KEY=nucleus_test_secret

# ----------------------------------------------------------------------------
# LLM provider keys (post v0.2 — Tier 2 onward)
# ----------------------------------------------------------------------------
# NOT used in v0.0.x / v0.1.x. Listed here so the contract is clear.
# Per docs/security/threat_model_v0.md §8, Nucleus NEVER proxies LLM calls —
# these keys are used directly by the user's client.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Local-only LLM (post v0.4):
# NUCLEUS_LLM_BACKEND=ollama
# NUCLEUS_LLM_OLLAMA_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# Telemetry / observability
# ----------------------------------------------------------------------------
# OpenTelemetry endpoint (post v0.1 — optional).

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=nucleus
