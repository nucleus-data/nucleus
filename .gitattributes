# Nucleus root .gitattributes
# Docs: https://git-scm.com/docs/gitattributes
#
# Forces LF line endings on text files cross-platform (the beachhead persona
# uses MacBooks + Linux + WSL2; Windows users transparently get CRLF in their
# working tree via core.autocrlf=true but the repo stores LF).

* text=auto eol=lf

# Explicit text
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.parquet binary
*.whl binary

# Generated files — exclude from diffs in PR review
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
uv.lock linguist-generated=true

# Preview-only React + TypeScript + Vite source tree (v0.3 work-in-progress).
# Per ADR-042 (docs/decisions/ADR-042-workbench-frontend-preview.md), v0.2.0
# ships the offline-renderable static SPA at src/nucleus/workbench/static/.
# `export-ignore` keeps the uncompiled preview tree out of `git archive`
# outputs (used by some sdist build paths) so end users do not download
# ~150 KB of source they cannot run without a Node toolchain that v0.2.0
# does not assume. Hatchling wheel builds are governed separately and
# tracked in ADR-042 Open Question §1.
# Docs: https://git-scm.com/docs/gitattributes#_export_ignore
src/nucleus/workbench/frontend/ export-ignore
src/nucleus/workbench/frontend/** export-ignore
